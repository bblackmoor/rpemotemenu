#!/bin/sh

set -eu

repo_root=$(git rev-parse --show-toplevel)
toc="$repo_root/RPEmoteMenu/RPEmoteMenu.toc"

if [ ! -f "$toc" ]; then
    echo "Error: $toc not found."
    exit 1
fi

if ! grep -q '^## Version:' "$toc"; then
    echo "Error: No version entry found in $toc."
    exit 1
fi

commit_count=$(git rev-list --count HEAD 2>/dev/null || printf '0')
build=$((commit_count + 1))

sed -i "s/^## Version:.*/## Version: 1.$build/" "$toc"

git add "$toc"

echo "Updated addon version to 1.$build"